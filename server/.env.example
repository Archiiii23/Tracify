# VASPTRACE API — environment configuration
# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/vasptrace

# Auth (required) — use a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated list supported)
CLIENT_URL=http://localhost:5173

# --- Chain data (GraphSense) ----------------------------------------------
# Leave GRAPHSENSE_API_URL empty to use the deterministic synthetic provider.
# Hosted: https://api.ikna.io  ·  self-hosted: http://localhost:9000
# In production the URL must be https and the key is mandatory.
GRAPHSENSE_API_URL=
GRAPHSENSE_API_KEY=
GRAPHSENSE_TIMEOUT_MS=12000

# --- EVM Chain data (Etherscan V2 multichain) -------------------------------
# One key unlocks Ethereum (1), Polygon (137), BSC (56), Arbitrum (42161).
# Ships with a public SIH demo key baked into the provider; set your own here
# to lift rate limits.
ETHERSCAN_API_KEY=NVCS3RGHYJGH6TCB7SWCMZGKWT1N4MW39M
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=

# Provider priority for future multi-provider routing (GraphSense → Etherscan today).
BLOCKCHAIN_PROVIDER_ORDER=graphsense,etherscan

# Demo / fallback — synthetic ledger when no live provider is configured.
DEMO_MODE=true

# Future provider slots (not yet wired — keep keys server-side only).
# ALCHEMY_API_KEY=
# MORALIS_API_KEY=
# TRON_PRO_API_KEY=
# HELIUS_API_KEY=
# BITCOIN_PROVIDER=alchemy
# SOLANA_PROVIDER=helius

# --- AI copilot (System 2) --------------------------------------------------
# LLM_PROVIDER=openai | gemini | anthropic
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=30000
# LLM_SEND_FULL_ADDRESSES=false
# LLM_SEND_VICTIM_DETAILS=false

# --- Gemini investigation agent (Phase 5-6) ---------------------------------
# Uses GEMINI_API_KEY when set; otherwise falls back to LLM_API_KEY when LLM_PROVIDER=gemini.
# Without a key the agent runs a deterministic local tool pipeline (no egress).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_AGENT_TOOL_CALLS=50
MAX_AGENT_PROVIDER_REQUESTS=100
MAX_AGENT_PAGES=20
MAX_AGENT_RUNTIME_SECONDS=120
MAX_AGENT_HOPS=3
MAX_AGENT_NODES=500
MAX_AGENT_EDGES=1500

# --- Complaint intake (NCRP / SAHYOG / LEA) ---------------------------------
# Comma-separated API keys presented as `x-api-key` on POST /api/intake/complaints.
# Leave empty to disable the machine-to-machine intake surface.
# Generate with: openssl rand -hex 32
INTAKE_API_KEYS=
